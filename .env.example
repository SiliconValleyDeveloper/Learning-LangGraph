# Local LLM via Ollama (no OpenAI key needed)
#   ollama pull qwen3:8b

OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Person Finder uses Tavily when set, otherwise DuckDuckGo (ddgs)
# TAVILY_API_KEY=

# Advanced chatbot (projects/advanced_chatbot)
# VECTOR_BACKEND=memory          # or pgvector
# DATABASE_URL=postgresql://langgraph:langgraph@localhost:5433/langgraph
# EMBED_DIMS=768
# OCR_PROVIDER=auto              # pdf → tesseract → ollama → deepseek
# OLLAMA_VISION_MODEL=moondream
# DEEPSEEK_OCR_BASE_URL=http://localhost:8001/v1
# DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
# DEEPSEEK_OCR_API_KEY=
# ADVANCED_UPLOAD_ROOT=.data/advanced-uploads
