# Local LLM via Ollama (no OpenAI key needed)
#   ollama pull qwen3:8b

OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Hugging Face token — faster/more reliable model downloads
# (needed for CrossEncoder rerank: cross-encoder/ms-marco-MiniLM-L-6-v2)
# Create at: https://huggingface.co/settings/tokens  (read access is enough)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Then:  source .venv/bin/activate && hf download cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: Person Finder uses Tavily when set, otherwise DuckDuckGo (ddgs)
# TAVILY_API_KEY=

# Advanced chatbot (projects/advanced_chatbot)
# VECTOR_BACKEND=memory          # or pgvector
# DATABASE_URL=postgresql://langgraph:langgraph@localhost:5433/langgraph
# EMBED_DIMS=768
# OCR_PROVIDER=auto              # pdf → tesseract → ollama → deepseek
# OLLAMA_VISION_MODEL=moondream
# DEEPSEEK_OCR_BASE_URL=http://localhost:8001/v1
# DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
# DEEPSEEK_OCR_API_KEY=
# ADVANCED_UPLOAD_ROOT=.data/advanced-uploads
# RERANK_BACKEND=auto            # lexical | auto | cross_encoder
# RETRIEVE_CANDIDATES=12
# RERANK_TOP_K=5

# Finance agent (projects/finance_agent) — analysis platform, not a broker
# See projects/finance_agent/WORKFLOW.md
FINANCE_ENABLED=true
DATABASE_URL=postgresql://langgraph:langgraph@localhost:5433/langgraph
REDIS_URL=redis://localhost:6379/0
VECTOR_BACKEND=pgvector
# NSE_BSE_INGEST_ENABLED=true
# FINANCE_INGEST_SOURCE=sample   # sample (offline) | live
# FINANCE_INGEST_REQUIRE_LOCK=false
# NSE_EQUITY_URL=                # live mode only (see WORKFLOW §3b gate)
# BSE_EQUITY_URL=
# CORP_ACTIONS_URL=
# FINANCE_API_AUTH_REQUIRED=true   # quote endpoints need X-API-Key
# FINANCE_API_KEY_PEPPER=change-me # used when hashing API keys
# FINANCE_API_DEFAULT_TIER=free
# FINANCE_API_DEFAULT_RPM=60
# FINANCE_QUOTE_SOURCE=auto         # auto | sample | kite
# FINANCE_QUOTE_TTL=15              # Redis TTL seconds
# FINANCE_QUOTE_PERSIST_TICKS=true
# FINANCE_QUOTE_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
# FINANCE_EMBED_BACKEND=auto       # auto | ollama | hash (filings F6)
# RERANK_BACKEND=auto              # lexical | auto | cross_encoder
# RETRIEVE_CANDIDATES=12
# RERANK_TOP_K=5
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=             # quotes session only — never commit
